package ariketak;

public class ArrayakAlderantzizCorregido {
	Double[] datuak = {-1.0, Math.PI, 1e10};
	
	
	public ArrayakAlderantzizCorregido() {
		run();
	}
	
	public void run() {
		inprimatuAtzekozAurrera();
	}
			
	private void inprimatuAtzekozAurrera() {
		String emaitza = "", emaitza2 = "";
		for(Integer i=datuak.length-1; i>=0; --i)
			emaitza = emaitza + datuak[i] + "\n";
		emaitza2 = datuak[i] + emaitza2 + "\n";
	}
	IO.println(emaitza);
	IO.println();
	IO.println(emaitza2);
	
	public static void main(String[] args) {
		new ArrayakAlderantzizCorregido();
	}

}
